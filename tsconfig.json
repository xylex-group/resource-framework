{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@xylex-group/resource-framework": ["./index.ts"],
      "@xylex-group/resource-framework/*": ["./*"],
      "@/packages/resource-framework": ["./"],
      "@/packages/resource-framework/*": ["./*"],
      "@/components/ui/badge": ["components/ui/badge.tsx"],
      "@/components/ui/button": ["components/ui/button.tsx"],
      "@/components/ui/card": ["components/ui/card.tsx"],
      "@/components/ui/checkbox": ["components/ui/checkbox.tsx"],
      "@/components/ui/combo-box": ["components/ui/combo-box.tsx"],
      "@/components/ui/dialog": ["components/ui/dialog.tsx"],
      "@/components/ui/input": ["components/ui/input.tsx"],
      "@/components/ui/label": ["components/ui/label.tsx"],
      "@/components/ui/number-field": ["components/ui/number-field.tsx"],
      "@/components/ui/popover": ["components/ui/popover.tsx"],
      "@/components/ui/select": ["components/ui/select.tsx"],
      "@/components/ui/separator": ["components/ui/separator.tsx"],
      "@/components/ui/skeleton": ["components/ui/skeleton.tsx"],
      "@/components/ui/switch": ["components/ui/switch.tsx"],
      "@/components/ui/textarea": ["components/ui/textarea.tsx"],
      "@/components/*": ["apps/demo/src/components/*"],
      "@/components/charts/*": ["apps/demo/src/components/charts/*"],
      "@/components/ui-responsive/*": ["apps/demo/src/components/ui-responsive/*"],
      "@/lib/*": ["apps/demo/src/lib/*"],
      "@/hooks/*": ["apps/demo/src/hooks/*"],
      "@/layouts/*": ["apps/demo/src/components/layouts/*"],
      "@/select/*": ["apps/demo/src/components/select/*"],
      "@/json/*": ["apps/demo/src/components/json/*"],
      "@/tabs/*": ["apps/demo/src/components/tabs/*"],
      "@/filters/*": ["apps/demo/src/components/filters/*"],
      "@/inputs/*": ["apps/demo/src/components/inputs/*"],
      "@/ui/*": ["apps/demo/src/components/ui/*"]
    },
    "types": ["node", "react", "react-dom"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["dist", "node_modules"]
}

