# Public Athena gateway used by browser-side framework adapters.
NEXT_PUBLIC_ATHENA_URL=https://athena-db.example.com

# Public-scoped Athena API key. Never place a privileged server key here.
NEXT_PUBLIC_ATHENA_API_KEY=athena_public_dummy_key

# Athena client catalog name used for database queries.
NEXT_PUBLIC_ATHENA_CLIENT=example_client

# Managed Athena storage catalog ID used for browser file operations.
NEXT_PUBLIC_ATHENA_STORAGE_S3_ID=s3_catalog_dummy_id
