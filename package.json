{
  "name": "@xylex-group/resource-framework",
  "version": "0.2.0",
  "description": "Composable resource table/drilldown framework with adapter-based UI bindings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XYLEX-Group/resource-framework.git"
  },
  "homepage": "https://xylex.group",
  "author": "XYLEX Group",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "rimraf dist && rollup -c && tsc -p tsconfig.build.json",
    "build:all": "turbo run build",
    "typecheck": "node scripts/typecheck-workspaces.mjs",
    "lint": "eslint . --ext .ts,.tsx,.mts,.cts --no-eslintrc -c .eslintrc.cjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.mts,.cts --no-eslintrc -c .eslintrc.cjs --fix",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:resource-forms": "vitest run tests/resource-forms.test.ts tests/resource-form-migrations.test.ts components/form-v2/__tests__/entity-form-v2.test.tsx apps/playground-next/src/app/admin/resource-forms/resource-forms-admin-client.test.tsx",
    "test:integration": "node scripts/run-athena-integration.mjs",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.0.0",
    "date-fns": "^3.0.0",
    "lucide-react": "^0.453.0",
    "md5": "^2.3.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-error-boundary": "^4.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.1",
    "@types/papaparse": "^5.4.4",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "class-variance-authority": "^0.7.1",
    "eslint": "^8.57.1",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "motion": "^12.34.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.24.0",
    "rollup-plugin-dts": "^6.1.1",
    "tslib": "^2.8.1",
    "turbo": "^2.1.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@xylex-group/athena": "^1.0.4",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "media-chrome": "^4.18.0",
    "papaparse": "^5.4.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  }
}
