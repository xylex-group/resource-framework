{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noImplicitAny": false,
    "strict": false
  },
  "include": [
    "index.ts",
    "adapters/**/*.ts",
    "adapters/**/*.tsx",
    "athena/**/*.ts",
    "constructors/**/*.ts",
    "constructors/**/*.tsx",
    "registries/filter-registry.tsx",
    "hooks/useUserScopes.ts",
    "hooks/useUserPreferences.ts",
    "utils/**/*.ts",
    "resource-types.ts",
    "components/index.ts",
    "components/cells/**/*.ts",
    "components/cells/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "types/**/*.ts",
    "demo/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}


