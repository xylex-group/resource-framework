{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@xylex-group/resource-framework": [
        "../../index.ts"
      ],
      "@xylex-group/resource-framework/*": [
        "../../*"
      ],
      "@/packages/resource-framework": [
        "../../"
      ],
      "@/packages/resource-framework/*": [
        "../../*"
      ],
      "@/components/*": [
        "../../apps/demo/src/components/*"
      ],
      "@/components/charts/*": [
        "../../apps/demo/src/components/charts/*"
      ],
      "@/components/ui-responsive/*": [
        "../../apps/demo/src/components/ui-responsive/*"
      ],
      "@/lib/*": [
        "../../apps/demo/src/lib/*"
      ],
      "@/hooks/*": [
        "../../apps/demo/src/hooks/*"
      ],
      "@/layouts/*": [
        "../../apps/demo/src/components/layouts/*"
      ],
      "@/select/*": [
        "../../apps/demo/src/components/select/*"
      ],
      "@/json/*": [
        "../../apps/demo/src/components/json/*"
      ],
      "@/tabs/*": [
        "../../apps/demo/src/components/tabs/*"
      ],
      "@/filters/*": [
        "../../apps/demo/src/components/filters/*"
      ],
      "@/inputs/*": [
        "../../apps/demo/src/components/inputs/*"
      ],
      "@/ui/*": [
        "../../apps/demo/src/components/ui/*"
      ],
      "@/drizzle/*": [
        "../../drizzle/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
