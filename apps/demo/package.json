{
  "name": "@xylex-group/demo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "db:apply:local": "wrangler d1 execute resource-framework-demo --local --file ../../sql/demo_contacts.sql",
    "db:apply:remote": "wrangler d1 execute resource-framework-demo --remote --file ../../sql/demo_contacts.sql",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@heroui/react": "3.0.4",
    "@xylex-group/resource-framework": "file:../..",
    "clsx": "^2.1.1",
    "date-fns": "^3.0.0",
    "lucide-react": "^0.453.0",
    "md5": "^2.3.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^4.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^4.3.10"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.15",
    "eslint": "^9.23.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.5.2",
    "wrangler": "4.110.0"
  }
}
